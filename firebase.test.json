{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9199
    },
    "firestore": {
      "port": 8180
    },
    "hub": {
      "port": 4410
    },
    "logging": {
      "port": 4510
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "hosting": {
      "port": 5055
    }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.json",
      "**/*.txt",
      "**/*.pem",
      "**/*.key",
      "**/*.env",
      "**/*credential*",
      "**/*secret*",
      "scripts/**",
      "docs/**",
      "tests/**",
      "README.md",
      "*.rules",
      "functions/**",
      "r2-worker/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/admin/",
        "destination": "/admin/index.html"
      },
      {
        "source": "/*",
        "destination": "/parish-home/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/admin.html",
        "destination": "/admin",
        "type": 301
      },
